-- ============================================================
--                      CONFIG
-- ============================================================
local HUB_NAME = "Swayz Premium"
local HUB_VERSION = "v1.0.0"
local DISCORD_INVITE = "https://discord.gg/eqMMpCWqPB"

-- each entry: name shown on the button, and the loadstring url
-- pressing the button: unload hub -> loadstring(url)()
