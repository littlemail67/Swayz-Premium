    {
        Name = "Operation One",
        Description = "Swayz Premium — Operation One",
        Script = "https://raw.githubusercontent.com/littlemail67/Swayz-Premium-Operation-One/main/operationonescript",
    },
}

-- ============================================================
--                  UNLOAD SYSTEM
-- ============================================================
local Window
local connections = {}
local isUnloaded = false

local function trackConnection(conn)
    table.insert(connections, conn)
    return conn
end

local function notify(title, content, duration)
    pcall(function()
        if Library and Library.Notify then
            Library:Notify{Title = title, Content = content, Duration = duration or 3}
        end
    end)
end

local function unloadHub()
    if isUnloaded then return end
    isUnloaded = true

    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    connections = {}

    if Window then
        pcall(function() Window:Destroy() end)
        Window = nil
    end

    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "🧹 " .. HUB_NAME,
            Text = "Unloaded — loading target script",
            Duration = 2
        })
    end)
end

getgenv().SWAYZ_HUB_UNLOAD = unloadHub

-- ============================================================
--                  SCRIPT LOADER
-- ============================================================
local function loadGameScript(entry)
    if not entry or not entry.Script or entry.Script == "" then
        notify("❌ Missing script", "No URL configured for " .. (entry and entry.Name or "?"), 3)
        return
    end

    notify("🔄 Loading", entry.Name .. "...", 2)

    task.wait(0.15)
    unloadHub()
    task.wait(0.35)

    local ok, err = pcall(function()
        loadstring(game:HttpGet(entry.Script))()
    end)

    if not ok then
        warn("[" .. HUB_NAME .. "] failed to load " .. entry.Name .. ": " .. tostring(err))
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "❌ Load Failed",
                Text = entry.Name .. " — check console",
                Duration = 4
            })
        end)
    end
end

